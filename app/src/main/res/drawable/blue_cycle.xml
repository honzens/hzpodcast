<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 固定大小；若由 View 決定大小，可移除 <size> -->
    <size
        android:width="20dp"
        android:height="20dp" />

    <solid android:color="#FF0000FF" />

    <!-- 若不要外框，移除這段 -->
    <stroke
        android:width="1dp"
        android:color="#FF929292" />
</shape>