<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_donate_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/app_donate_desc"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@color/dark_gray" />

    <ImageView
        android:id="@+id/imgTwqr"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="20dp"
        android:contentDescription="@string/twqr_qr_code"
        android:scaleType="fitCenter"
        android:src="@drawable/twqr_donate" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/app_qr_code"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/dark_gray" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/donate_desc"
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="@color/dark_gray" />

    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="關閉" />

</LinearLayout>